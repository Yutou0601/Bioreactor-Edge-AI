# 站台設定範本 —— 複製成 .env 再改成這台機器的值
#
#     copy .env.example .env
#
# .env 不進版控，所以 git pull 不會覆蓋你在這台機器改過的設定。
# 環境變數優先於本檔，臨時覆蓋不必改檔案。

# 記錄程式寫出 CSV 的資料夾（csv_watcher 監看它）
REACTOR_DATA_DIR=C:\Users\BTP\Desktop\data

# 後端位址與埠
REACTOR_HOST=127.0.0.1
REACTOR_PORT=8000

# 循環資料庫路徑。留空 = edge_backend/reactor.db
REACTOR_DB=

# LSTM 壓力預測。預設 0（關）。
# 開成 1 會讓 CSV 匯入把 torch 拉進常駐行程（實測 RSS 62 -> 348 MB），
# 而該預測值前端並不顯示。除非確定要用，否則不要開。
REACTOR_ENABLE_LSTM=0

# csv_watcher 檢查資料夾的間隔（秒）
REACTOR_POLL_SECONDS=60


# ══════════════════════════════════════════════════════════════════
# 兩台機器的分工
# ══════════════════════════════════════════════════════════════════
# 這台機器的角色。只有兩個值，打錯字會當場失敗（不會默默當成 monitor）。
#
#   monitor  4 GB 的 Windows 監控電腦：收 CSV、跑 API 與前端。
#            常駐核心預算 60 MB，重量級套件一律不得進來。
#   compute  Jetson Orin NX 16 GB：重運算常駐在這台，套件熱著、吃得到 GPU。
#
REACTOR_PROFILE=monitor

# ── 只有 monitor 那台要設 ──────────────────────────────────────────
# 重運算節點的位址。留空 = 沒有這台，模組照舊在本機開短命子行程跑
#   （單機部署、開發筆電、Orin 還沒到之前，都留空就好）。
# 設了值 = 模組送到 Orin 跑，監控電腦這邊連子行程都不用開。
#
# ⚠ 設了之後 Orin 若連不到，模組會**失敗**並在紀錄裡寫「連不到重運算節點」，
#   不會靜默退回本機跑。這是故意的：靜默退回的話，那台 16 GB 的機器可以
#   壞掉好幾個月而沒有人發現（torch 就這樣藏了好幾個月）。
#   要看目前走哪條路：GET /api/modules 的 backend 欄位。
#
# REACTOR_COMPUTE_URL=http://192.168.1.50:8100

# 等重運算節點回覆的上限（秒）。要比模組自己的 timeout_s 寬，
# 否則慢的模組（greybox 宣告 300 秒）每次都會被這裡先砍掉。
REACTOR_COMPUTE_TIMEOUT=600

# ── 只有 compute 那台要設 ──────────────────────────────────────────
# 重運算節點監聽的埠（compute_node/server.py 讀這個）。預設 8100。
# REACTOR_COMPUTE_PORT=8100
