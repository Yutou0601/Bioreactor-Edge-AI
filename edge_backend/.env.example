# 站台設定範本 —— 複製成 .env 再改成這台機器的值
#
#     copy .env.example .env
#
# .env 不進版控，所以 git pull 不會覆蓋你在這台機器改過的設定。
# 環境變數優先於本檔，臨時覆蓋不必改檔案。

# 記錄程式寫出 CSV 的資料夾（csv_watcher 監看它）
REACTOR_DATA_DIR=C:\Users\BTP\Desktop\data

# 後端位址與埠
REACTOR_HOST=127.0.0.1
REACTOR_PORT=8000

# 循環資料庫路徑。留空 = edge_backend/reactor.db
REACTOR_DB=

# LSTM 壓力預測。預設 0（關）。
# 開成 1 會讓 CSV 匯入把 torch 拉進常駐行程（實測 RSS 62 -> 348 MB），
# 而該預測值前端並不顯示。除非確定要用，否則不要開。
REACTOR_ENABLE_LSTM=0

# csv_watcher 檢查資料夾的間隔（秒）
REACTOR_POLL_SECONDS=60
